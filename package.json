{
  "name": "molan",
  "private": true,
  "version": "1.0.0-alpha.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mac": "bash scripts/build-dmg.sh",
    "build:mac:arm": "bash scripts/build-dmg.sh --arch=arm",
    "build:mac:intel": "bash scripts/build-dmg.sh --arch=intel",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "TAURI_DEV_DATA_DIR=./src-tauri/tauri_dev_data pnpm tauri dev",
    "format": "prettier --write src && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md,yaml,yml}": "prettier --write",
    "src-tauri/**/*.rs": "rustfmt --edition 2021"
  },
  "dependencies": {
    "@ant-design/icons": "~6.3.2",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@gsap/react": "^2.1.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "ahooks": "^3.9.7",
    "antd": "^6.3.6",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "keepalive-for-react": "^5.0.11",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.1.0",
    "react-router": "^8.2.0",
    "react-router-dom": "^7.14.2",
    "shadcn": "^4.13.0",
    "simplebar-react": "^3.3.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.10.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "sass": "^1.103.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
