<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 完全磁盘访问权限说明 -->
    <key>NSFullDiskAccessUsageDescription</key>
    <string>MoleDesktop 需要完全磁盘访问权限以扫描系统垃圾文件、缓存和日志，帮助您清理磁盘空间。</string>

    <!-- 文件系统访问权限（可选，某些版本 macOS 可能需要） -->
    <key>NSFileSystemUsageDescription</key>
    <string>MoleDesktop 需要访问文件系统以分析和清理垃圾文件。</string>
</dict>
</plist>
