{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Molan",
  "version": "1.0.0-alpha.2",
  "identifier": "com.tiyong.molan",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "Molan",
        "title": "Molan",
        "width": 1056,
        "height": 640,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      },
      {
        "label": "dashboard",
        "title": "Dashboard",
        "width": 360,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "url": "/dashboard",
        "visible": false
      },
      {
        "label": "settings",
        "title": "设置",
        "width": 680,
        "height": 600,
        "resizable": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "url": "/settings",
        "visible": false
      },
      {
        "label": "trash-reminder",
        "title": "废纸篓提醒",
        "width": 344,
        "height": 144,
        "focus": false,
        "shadow": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "url": "/trash-reminder",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": "-",
      "entitlements": null,
      "providerShortName": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/tiyong/Molan/raw/master/update/latest.json",
        "https://github.com/tiyongLit/Molan/raw/main/update/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1QzU4M0Y1MTlENjc4NTIKUldSU2VOWVo5WVBGeFJqaXlwMS90YUw2b1hGNnNBWGNsRW9QWFM1dU5FY0MxVTZkRnUrQmpzMFEK"
    }
  }
}
